SELECT _get_nicknames('Robert', 'unknown');
----
unknown version

statement error
SELECT _get_nicknames(NULL, 'unknown');
----
unknown version

statement error
SELECT _get_nicknames('Robert', NULL);
----
version must be a non-NULL constant

statement error
SELECT _get_nicknames('Robert', version) FROM (VALUES ('v1')) t(version);
----
version must be a non-NULL constant resolved during binding

query I
SELECT _get_nicknames('Robert', 'v' || '1') = _get_nicknames('Robert', 'v1');
----
true

